# Groq API key — get one at https://console.groq.com
GROQ_API_KEY=your_key_here

# LLM model name (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Set to "true" to enable LangChain debug/verbose logging
AGENT_DEBUG=false

# Comma-separated list of allowed CORS origins (default: * for dev)
# Example: CORS_ORIGINS=https://myapp.com,https://staging.myapp.com
CORS_ORIGINS=*

# Optional: Frontend API URL (for Vite builds targeting production)
# VITE_API_URL=https://your-api.onrender.com/api
